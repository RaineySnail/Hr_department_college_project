<Window x:Class="HrDepartment.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Редактирование сотрудника"
        Height="700"
        Width="520"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Редактирование" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Измените данные сотрудника" Style="{StaticResource HintText}" Margin="0,4,0,10"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">

                        <TextBlock Text="Подразделение" Style="{StaticResource HintText}"/>
                        <ComboBox x:Name="DepartmentComboBox" ItemsSource="{Binding Departments}"
                                  DisplayMemberPath="DepartmentName"
                                  SelectedValuePath="DepartmentId"
                                  SelectedValue="{Binding SelectedEmployee.DepartmentId}"
                                  Margin="0,6,0,12"/>

                        <TextBlock Text="Должность" Style="{StaticResource HintText}"/>
                        <ComboBox x:Name="PositionComboBox" ItemsSource="{Binding Positions}"
                                  DisplayMemberPath="PositionName"
                                  SelectedValuePath="PositionId"
                                  SelectedValue="{Binding SelectedEmployee.PositionId}"
                                  Margin="0,6,0,12"/>

                        <TextBlock Text="ФИО" Style="{StaticResource HintText}"/>
                        <TextBox Text="{Binding SelectedEmployee.FullName}" Margin="0,6,0,12"/>

                        <TextBlock Text="Дата рождения (ГГГГ-ММ-ДД)" Style="{StaticResource HintText}"/>
                        <TextBox Text="{Binding SelectedEmployee.BirthDateString, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Формат: ГГГГ-ММ-ДД (например: 1990-05-15)"
                                 Margin="0,6,0,12"/>

                        <TextBlock Text="Кабинет" Style="{StaticResource HintText}"/>
                        <TextBox x:Name="OfficeTextBox" Text="{Binding SelectedEmployee.Office, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>

                        <TextBlock Text="Личный телефон" Style="{StaticResource HintText}"/>
                        <TextBox Text="{Binding SelectedEmployee.PersonalPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>

                        <TextBlock Text="Рабочий телефон" Style="{StaticResource HintText}"/>
                        <TextBox x:Name="WorkPhoneTextBox" Text="{Binding SelectedEmployee.WorkPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12"/>

                        <TextBlock Text="Email" Style="{StaticResource HintText}"/>
                        <TextBox Text="{Binding SelectedEmployee.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Сохранить" Click="SaveChanges_Click" Style="{StaticResource PrimaryButton}" Width="120" Margin="0,0,10,0"/>
                    <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource ButtonBase}" Width="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
