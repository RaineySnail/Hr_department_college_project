<Window x:Class="HrDepartment.EventOnDateReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёт по событиям на дату"
        Height="620" Width="980">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleText}" Text="Отчёт: сотрудники по событию на дату"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Дата" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="DatePicker" Width="160"/>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="Тип события" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox x:Name="TypeCombo" Width="220"/>

                    <Button Content="Сформировать" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"
                            Click="Build_Click" Width="140"/>
                </WrapPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Экспорт CSV" Style="{StaticResource ButtonBase}" Width="140"
                            Click="Export_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid x:Name="Grid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="220"/>
                    <DataGridTextColumn Header="Должность" Binding="{Binding PositionName}" Width="220"/>
                    <DataGridTextColumn Header="С" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="По" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Обоснование" Binding="{Binding Reason}" Width="240"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
