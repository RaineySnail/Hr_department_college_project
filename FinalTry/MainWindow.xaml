<Window x:Class="HrDepartment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HR Department"
        Height="820"
        Width="1280"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Canvas x:Key="PersonIcon" Width="24" Height="24">
            <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                  Fill="White"/>
        </Canvas>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF1FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Background="#E8F0FF" CornerRadius="999" Padding="12,5" HorizontalAlignment="Left">
                        <TextBlock Text="Кадровая информационная система" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Отдел кадров" Style="{StaticResource TitleText}" Margin="0,12,0,0"/>
                    <TextBlock Text="Работа с сотрудниками, отпусками, событиями и кадровыми данными"
                               Style="{StaticResource HintText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                        <StackPanel>
                            <TextBlock x:Name="UserInfoText" Style="{StaticResource HintText}" TextAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="LogoutButton"
                            Content="Сменить пользователя"
                            Width="185"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButton}"
                            Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}" CornerRadius="22" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#172554" CornerRadius="18" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="HR Department" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1"
                                       Text="Управление персоналом"
                                       Foreground="#CBD5E1"
                                       Margin="0,8,0,14"/>
                            <Image Grid.Row="2" Source="Images/logo.png" Stretch="Uniform" HorizontalAlignment="Center" MaxHeight="92"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Основные действия" Foreground="#94A3B8" Margin="4,0,0,8" FontWeight="SemiBold"/>
                    <Button Content="Все сотрудники" Click="ShowAll_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="ReportButton" Content="Общий отчёт по сотрудникам" Click="GenerateReport_Click" Style="{StaticResource SidebarButton}"/>
                    <Button Content="Отчёт по событиям на дату" Style="{StaticResource SidebarButton}" Click="OpenEventOnDateReport_Click"/>
                    <Button Content="Отчёт по подразделениям" Style="{StaticResource SidebarButton}" Click="OpenDepartmentCountReport_Click"/>
                    <Button x:Name="BirthdayReportButton" Content="Отчёт по дням рождения" Style="{StaticResource SidebarButton}" Click="OpenBirthdayReport_Click"/>

                    <Separator Margin="0,12" Background="#334155"/>

                    <TextBlock Text="Работа с сотрудником" Foreground="#94A3B8" Margin="4,0,0,8" FontWeight="SemiBold"/>
                    <Button x:Name="EditEmployeeButton" Content="Редактировать сотрудника" IsEnabled="False" Click="EditEmployee_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="DeleteEmployeeButton" Content="Удалить сотрудника" IsEnabled="False" Click="DeleteEmployee_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="VacationButton" Content="Оформить отпуск" IsEnabled="False" Click="CreateVacationEvent_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="CareerHistoryButton" Content="История карьеры" IsEnabled="False" Click="ShowCareerHistory_Click" Style="{StaticResource SidebarButton}"/>
                    <Button Content="Обновить данные" Click="RefreshData_Click" Style="{StaticResource SidebarButton}"/>

                    <Separator Margin="0,12" Background="#334155"/>

                    <TextBlock Text="Администрирование" Foreground="#94A3B8" Margin="4,0,0,8" FontWeight="SemiBold"/>
                    <Button x:Name="EventsJournalButton" Content="Журнал событий" Click="OpenEventsJournal_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="EventTypesButton" Content="Типы событий" Style="{StaticResource SidebarButton}" Click="OpenEventTypes_Click"/>
                    <Button x:Name="ManageUsersButton" Content="Управление пользователями" Click="ManageUsers_Click" Style="{StaticResource SidebarButton}"/>
                    <Button x:Name="ManageDepartmentsButton" Content="Управление отделами" Click="ManageDepartments_Click" Style="{StaticResource SidebarButton}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Всего в текущем списке" Style="{StaticResource HintText}"/>
                        <TextBlock x:Name="MetricEmployeesCountText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,8,0,0"/>
                        <TextBlock Text="Количество сотрудников с учётом выбранных фильтров" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Сейчас в отпуске" Style="{StaticResource HintText}"/>
                        <TextBlock x:Name="MetricVacationCountText" Text="0" Style="{StaticResource MetricValueText}" Margin="0,8,0,0"/>
                        <TextBlock Text="Число сотрудников, находящихся в отпуске в текущей выборке" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Выбранный сотрудник" Style="{StaticResource HintText}"/>
                        <TextBlock x:Name="SelectedEmployeeNameText" Text="—" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SelectedEmployeeRoleText" Text="Выберите запись в списке для быстрых действий" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*"/>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Поиск" Style="{StaticResource SectionLabel}"/>
                        <Grid Margin="0,4,0,0">
                            <TextBox x:Name="EmployeeSearchBox" MinHeight="38" Padding="12,6" TextChanged="EmployeeSearchBox_TextChanged"/>
                            <TextBlock Text="Введите ФИО, должность или отдел"
                                       Foreground="#94A3B8"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=EmployeeSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Подразделение" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="DepartmentFilterComboBox" Margin="0,4,0,0" MinHeight="38" SelectionChanged="DepartmentFilterComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,12,2">
                        <CheckBox x:Name="VacationOnlyCheckBox"
                                  Content="Только в отпуске"
                                  Checked="VacationOnlyCheckBox_Changed"
                                  Unchecked="VacationOnlyCheckBox_Changed"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Width="130"
                            Margin="0,22,0,0"
                            VerticalAlignment="Top"
                            Content="Сбросить"
                            Style="{StaticResource PrimaryButton}"
                            Click="ResetFiltersButton_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Grid.Row="2" Padding="0">
                <Grid>
                    <ListView x:Name="EmployeesList"
                              Margin="14"
                              ItemsSource="{Binding Employees}"
                              SelectionMode="Single"
                              BorderThickness="0"
                              MouseDoubleClick="EmployeesList_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12" Padding="16" Background="White">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="46" Height="46" Background="{StaticResource AccentBrush}" CornerRadius="14" Margin="0,0,12,0">
                                                    <Viewbox Stretch="Uniform">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" Fill="White"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FullName}" FontSize="17" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding PositionName}" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource InfoBadge}" Visibility="{Binding IsOnVacation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="В отпуске" Foreground="#B45309" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid Margin="58,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Подразделение" Style="{StaticResource SectionLabel}"/>
                                                <TextBlock Text="{Binding DepartmentName}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                                <TextBlock Text="Кабинет" Style="{StaticResource SectionLabel}"/>
                                                <TextBlock Text="{Binding Office}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="Email" Style="{StaticResource SectionLabel}"/>
                                                <TextBlock Text="{Binding Email}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                                <TextBlock Text="Телефон" Style="{StaticResource SectionLabel}"/>
                                                <TextBlock Text="{Binding PersonalPhone}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Адрес" Style="{StaticResource SectionLabel}"/>
                                                <TextBlock Text="{Binding Address}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                <TextBlock Text="Дата рождения" Style="{StaticResource SectionLabel}"/>
                                                <TextBlock Text="{Binding BirthDate, StringFormat=dd.MM.yyyy}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border x:Name="EmptyStateBorder"
                            Background="#FCFDFE"
                            CornerRadius="16"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Margin="14"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <TextBlock Text="Сотрудники не найдены" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Попробуйте очистить строку поиска, выбрать другой отдел или снять фильтр по отпускам."
                                       Style="{StaticResource HintText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="EmployeesCountText" Text="Сотрудников: 0" Style="{StaticResource HintText}"/>
                    <TextBlock x:Name="SelectedEmployeeText" Text="Выбран: —" Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="AddEmployeeButton"
                        Content="+ Добавить сотрудника"
                        HorizontalAlignment="Right"
                        Width="190"
                        Style="{StaticResource PrimaryButton}"
                        Click="OpenEmployeeDataWindow"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
