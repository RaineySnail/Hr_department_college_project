<Window x:Class="HrDepartment.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Height="560"
        Width="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <!-- 🔵 ЛЕВАЯ ЧАСТЬ (ИСПРАВЛЕНА) -->
        <Border Background="#0F172A" CornerRadius="24" Margin="0,0,18,0" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верх -->
                <StackPanel>
                    <TextBlock Text="HR Department" Foreground="White" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Кадровая система управления сотрудниками"
                               Foreground="#CBD5E1"
                               Margin="0,10,0,0"
                               FontSize="15"/>
                </StackPanel>

                <!-- Центр -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Система учета сотрудников"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Выполните вход для продолжения работы в системе"
                               Foreground="#CBD5E1"
                               Margin="0,12,0,22"
                               FontSize="15"
                               TextWrapping="Wrap"/>

                    <Border Background="#172554"
                            CornerRadius="18"
                            Padding="18"
                            MaxWidth="420">
                        <StackPanel>
                            <TextBlock Text="Назначение программы"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="15"/>

                            <TextBlock Text="Система предназначена для хранения сведений о сотрудниках, просмотра кадровой информации и оформления отпусков."
                                       Foreground="#CBD5E1"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Низ -->
                <TextBlock Grid.Row="2"
                           Text="© Отдел кадров"
                           Foreground="#94A3B8"/>
            </Grid>
        </Border>

        <!-- 🔵 ПРАВАЯ ЧАСТЬ (НЕ ТРОГАЛ) -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="28" VerticalAlignment="Center">
            <StackPanel>
                <Border Background="#E8F0FF" CornerRadius="999" Padding="12,5" HorizontalAlignment="Left">
                    <TextBlock Text="Безопасный вход" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Text="Вход в систему" Style="{StaticResource TitleText}" Margin="0,16,0,0"/>
                <TextBlock Text="Введите учётные данные, чтобы открыть кадровую панель." Style="{StaticResource HintText}" Margin="0,8,0,22" TextWrapping="Wrap"/>

                <TextBlock Text="Логин" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="txtUsername" Margin="0,4,0,14"/>

                <TextBlock Text="Пароль" Style="{StaticResource SectionLabel}"/>
                <PasswordBox x:Name="txtPassword" Margin="0,4,0,22" KeyDown="txtPassword_KeyDown"/>

                <Button Content="Войти" Height="42" Style="{StaticResource PrimaryButton}" Click="Login_Click"/>

                <Border Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,18,0,0">

                    <TextBlock Text="Нажмите Enter после ввода пароля"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>