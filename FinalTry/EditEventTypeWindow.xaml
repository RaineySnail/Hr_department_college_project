<Window x:Class="HrDepartment.EditEventTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тип события"
        Height="220" Width="460"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" Text="Тип события"/>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="Название"/>
                <TextBox x:Name="NameBox" />
                <TextBlock x:Name="HintText" Margin="0,8,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Пример: Отпускной, Больничный, Отгул"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="120" Click="Save_Click"/>
            <Button Content="Отмена" Style="{StaticResource ButtonBase}" Width="120" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
