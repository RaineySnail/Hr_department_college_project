<Window x:Class="HrDepartment.VacationRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление отпуска"
        Height="640"
        Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <StackPanel>
                    <TextBlock Text="Оформление отпуска" Style="{StaticResource TitleText}"/>
                    <TextBlock x:Name="EmployeeNameText" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#E8F0FF" CornerRadius="999" Padding="12,5" VerticalAlignment="Top">
                    <TextBlock Text="Формирование документа" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Параметры отпуска" Style="{StaticResource SubtitleText}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Дата начала" Style="{StaticResource SectionLabel}"/>
                            <DatePicker x:Name="StartDatePicker"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Дата окончания" Style="{StaticResource SectionLabel}"/>
                            <DatePicker x:Name="EndDatePicker"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Основание" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="ReasonTextBox" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,4,0,12"/>

                    <TextBlock Text="Подпись сотрудника" Style="{StaticResource SectionLabel}"/>
                    <TextBox x:Name="SignatureTextBox" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Подтверждения" Style="{StaticResource SubtitleText}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="PersonalDataConsentCheckBox" Content="Подтверждено согласие на обработку персональных данных"/>
                        <CheckBox x:Name="VacationConsentCheckBox" Margin="0,8,0,0" Content="Подтверждено согласие сотрудника на оформление отпуска"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Что произойдёт после сохранения" Style="{StaticResource SubtitleText}" Margin="0,0,0,10"/>
                        <TextBlock Text="1. Будет создано событие отпуска в базе данных."
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="2. Обновится признак нахождения сотрудника в отпуске."
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SavePathInfoText"
                                   Text="3. Excel-документ будет сохранён на рабочем столе в папке HR Department\Отпуска."
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Оформить отпуск" Width="160" Margin="0,0,10,0" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Content="Отмена" Width="120" Style="{StaticResource ButtonBase}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
