<Window x:Class="HrDepartment.DepartmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление отделами"
        Height="560"
        Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Управление отделами" Style="{StaticResource TitleText}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,10">
            <DockPanel>
                <TextBlock Text="Поиск:" Style="{StaticResource HintText}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <TextBox x:Name="SearchTextBox"
                         Width="260"
                         GotFocus="SearchTextBox_GotFocus"
                         LostFocus="SearchTextBox_LostFocus"
                         TextChanged="SearchTextBox_TextChanged"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid x:Name="DepartmentsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionChanged="DepartmentsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Width="70" Binding="{Binding id_department}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Название отдела" Width="260" Binding="{Binding Название_подразделения}"/>
                    <DataGridTextColumn Header="Кол-во сотрудников" Width="160" Binding="{Binding К-во_сотрудников}"/>
                    <DataGridTextColumn Header="Описание" Width="*" Binding="{Binding описание}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Добавить" Click="AddDepartment_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Width="120"/>
            <Button Content="Редактировать" Click="EditDepartment_Click" Style="{StaticResource ButtonBase}" Margin="0,0,10,0" Width="140"/>
            <Button Content="Удалить" Click="DeleteDepartment_Click" Style="{StaticResource DangerButton}" Margin="0,0,10,0" Width="120"/>
            <Button Content="Закрыть" Click="Close_Click" Style="{StaticResource ButtonBase}" Width="120"/>
        </StackPanel>
    </Grid>
</Window>
