<Window x:Class="HrDepartment.CareerMoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кадровое перемещение"
        Height="480"
        Width="620"
        MinHeight="430"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Кадровое перемещение" Style="{StaticResource TitleText}"/>
                <TextBlock Text="{Binding FullName}" Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Перевод сотрудника на новую должность / в новое подразделение"
                           Style="{StaticResource HintText}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Подразделение"
                           Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                <ComboBox x:Name="DepartmentComboBox"
                          Grid.Row="0" Grid.Column="1"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0,0,0,12"
                          MinHeight="32"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Должность"
                           Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                <ComboBox x:Name="PositionComboBox"
                          Grid.Row="1" Grid.Column="1"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0,0,0,12"
                          MinHeight="32"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата начала"
                           Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,12,12"/>
                <DatePicker x:Name="StartDatePicker"
                            Grid.Row="2" Grid.Column="1"
                            Margin="0,0,0,12"
                            SelectedDateFormat="Short"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Примечание"
                           Style="{StaticResource SectionLabel}" VerticalAlignment="Top" Margin="0,0,12,0"/>
                <TextBox x:Name="NoteTextBox"
                         Grid.Row="3" Grid.Column="1"
                         Height="110"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить"
                    Width="140"
                    Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="Save_Click"/>

            <Button Content="Отмена"
                    Width="120"
                    Style="{StaticResource ButtonBase}"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>