<Window x:Class="HrDepartment.CareerRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить запись карьеры" 
        Height="564" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#f0f4ff">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#6c5ce7" CornerRadius="4" Padding="10" Margin="0 0 0 15">
            <TextBlock Text="{Binding WindowTitle}" 
                       Foreground="White" 
                       FontSize="16" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1">
            <!-- ID отдела -->
            <Label Content="ID отдела" Foreground="#2d3436"/>
            <TextBox Text="{Binding CurrentRecord.DepartmentId}" 
                     Margin="0 5 0 10"/>

            <!-- ID должности -->
            <Label Content="ID должности" Foreground="#2d3436"/>
            <TextBox Text="{Binding CurrentRecord.PositionId}" 
                     Margin="0 5 0 10"/>

            <!-- Дата начала -->
            <Label Content="Дата начала" Foreground="#2d3436"/>
            <DatePicker SelectedDate="{Binding CurrentRecord.StartDate}" 
                        Margin="0 5 0 10"/>

            <!-- Дата окончания (может быть пустой) -->
            <Label Content="Дата окончания (оставьте пустым, если текущая)" Foreground="#2d3436"/>
            <DatePicker SelectedDate="{Binding CurrentRecord.EndDate}" 
                        Margin="0 5 0 10"/>

            <!-- Зарплата -->
            <Label Content="Зарплата" Foreground="#2d3436"/>
            <TextBox Text="{Binding CurrentRecord.Salary}" 
                     Margin="0 5 0 10"/>

            <!-- Примечание -->
            <Label Content="Примечание" Foreground="#2d3436"/>
            <TextBox Text="{Binding CurrentRecord.Note}" 
                     AcceptsReturn="True"
                     Height="60"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0 5 0 10"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" 
                    Click="Save_Click" 
                    Background="#6c5ce7" 
                    Foreground="White"
                    Padding="10 5" 
                    Margin="0 0 10 0"
                    Width="100"/>
            <Button Content="Отмена" 
                    Click="Cancel_Click" 
                    Background="#e57373"
                    Foreground="White"
                    Padding="10 5"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>