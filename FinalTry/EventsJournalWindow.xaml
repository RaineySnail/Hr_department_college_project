<Window x:Class="HrDepartment.EventsJournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал событий"
        Height="650" Width="1040"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Журнал событий" Style="{StaticResource TitleText}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="С" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource HintText}"/>
                <DatePicker x:Name="FromDate" Width="150"/>

                <TextBlock Text="По" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource HintText}"/>
                <DatePicker x:Name="ToDate" Width="150"/>

                <TextBlock Text="Тип" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource HintText}"/>
                <ComboBox x:Name="TypeCombo" Width="200"/>

                <TextBlock Text="Сотрудник" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource HintText}"/>
                <TextBox x:Name="EmployeeQuery" Width="220"/>

                <Button Content="Найти" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}" Click="Search_Click"/>
                <Button Content="Сброс" Margin="8,0,0,0" Style="{StaticResource ButtonBase}" Click="Reset_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DataGrid x:Name="GridEvents" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="130"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding EventTypeName}" Width="160"/>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="*"/>
                    <DataGridTextColumn Header="Обоснование" Binding="{Binding Reason}" Width="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</Window>
