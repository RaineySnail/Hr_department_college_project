<Window x:Class="HrDepartment.DepartmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование отдела" 
        Height="350" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#f0f4ff">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#6c5ce7" CornerRadius="4" Padding="10" Margin="0 0 0 15">
            <TextBlock Text="{Binding WindowTitle}" 
                       Foreground="White" 
                       FontSize="16" 
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1">
            <!-- Название отдела -->
            <Label Content="Название отдела *" Foreground="#2d3436" FontWeight="SemiBold"/>
            <TextBox x:Name="DepartmentNameTextBox" 
                     Text="{Binding DepartmentName}"
                     Margin="0 5 0 15"
                     Height="30"/>

            <!-- Количество сотрудников -->
            <Label Content="Количество сотрудников" Foreground="#2d3436"/>
            <TextBox x:Name="EmployeeCountTextBox" 
                     Text="{Binding EmployeeCount}"
                     Margin="0 5 0 15"
                     Height="30"
                     PreviewTextInput="NumberValidationTextBox"/>

            <!-- Описание -->
            <Label Content="Описание" Foreground="#2d3436"/>
            <TextBox x:Name="DescriptionTextBox" 
                     Text="{Binding Description}"
                     AcceptsReturn="True"
                     Height="80"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0 5 0 15"
                     TextWrapping="Wrap"/>

            <TextBlock Text="* - обязательное поле" 
                       Foreground="#666" 
                       FontSize="11" 
                       FontStyle="Italic"
                       Margin="0 10 0 0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" 
                    Click="Save_Click" 
                    Background="#6c5ce7" 
                    Foreground="White"
                    Padding="15 8" 
                    Margin="0 0 10 0"
                    Width="120"
                    FontWeight="SemiBold"/>
            <Button Content="Отмена" 
                    Click="Cancel_Click" 
                    Background="#e57373"
                    Foreground="White"
                    Padding="15 8"
                    Width="120"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>