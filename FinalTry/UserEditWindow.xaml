<Window x:Class="HrDepartment.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь"
        Height="420"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WindowTitleText"
                   Text="Пользователь"
                   Style="{StaticResource TitleText}"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Логин" Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="UsernameBox" Grid.Row="0" Margin="0,26,0,0"/>

                <TextBlock Grid.Row="1" Text="ФИО" Style="{StaticResource SectionLabel}" Margin="0,14,0,0"/>
                <TextBox x:Name="FullNameBox" Grid.Row="1" Margin="0,40,0,0"/>

                <TextBlock Grid.Row="2" Text="Роль" Style="{StaticResource SectionLabel}" Margin="0,14,0,0"/>
                <ComboBox x:Name="RoleComboBox"
                          Grid.Row="2"
                          Margin="0,40,0,0"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"/>

                <TextBlock Grid.Row="3" Text="Пароль" Style="{StaticResource SectionLabel}" Margin="0,14,0,0"/>
                <PasswordBox x:Name="PasswordBox" Grid.Row="3" Margin="0,40,0,0"/>

                <TextBlock x:Name="PasswordHintText"
                           Grid.Row="3"
                           Margin="0,74,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Введите пароль пользователя."
                           TextWrapping="Wrap"/>

                <CheckBox x:Name="IsActiveCheckBox"
                          Grid.Row="4"
                          Margin="0,18,0,0"
                          Content="Пользователь активен"
                          IsChecked="True"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Width="120" Click="Save_Click"/>
            <Button Content="Отмена" Style="{StaticResource ButtonBase}" Width="120" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
