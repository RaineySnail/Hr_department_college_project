<Window x:Class="HrDepartment.FirstTimeUserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Первичное заполнение данных"
        Height="760"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="18">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Первичный вход пользователя" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Сначала пользователь должен дать согласие на обработку персональных данных и сам заполнить свою личную карточку." Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="ФИО" Style="{StaticResource SectionLabel}"/>
                        <TextBox x:Name="FullNameTextBox"/>

                        <TextBlock Text="Дата рождения" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <DatePicker x:Name="BirthDatePicker"/>

                        <TextBlock Text="Личный телефон" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="PersonalPhoneTextBox"/>

                        <TextBlock Text="Рабочий телефон" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="WorkPhoneTextBox"/>

                        <TextBlock Text="Корпоративный email" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="EmailTextBox"/>

                        <TextBlock Text="Адрес проживания" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="AddressTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>

                        <TextBlock Text="Место рождения" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="PlaceOfBirthTextBox"/>

                        <TextBlock Text="Паспортные данные" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="PassportTextBox"/>

                        <TextBlock Text="СНИЛС" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="SnilsTextBox"/>

                        <TextBlock Text="ИНН" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="InnTextBox"/>

                        <TextBlock Text="Гражданство" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="CitizenshipTextBox"/>

                        <TextBlock Text="Образование" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <TextBox x:Name="EducationTextBox"/>

                        <TextBlock Text="Пол" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                        <ComboBox x:Name="GenderComboBox">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="Мужской"/>
                            <ComboBoxItem Content="Женский"/>
                        </ComboBox>

                        <Border Background="#EFF6FF" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Согласие на обработку персональных данных" FontWeight="SemiBold"/>
                                <TextBlock Text="Я подтверждаю согласие на обработку, хранение и использование моих персональных данных в кадровой системе организации." TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <CheckBox x:Name="ConsentCheckBox" Margin="0,10,0,0" Content="Согласие даю"/>
                                <TextBlock Text="Подпись (ФИО полностью)" Style="{StaticResource SectionLabel}" Margin="0,12,0,0"/>
                                <TextBox x:Name="SignatureTextBox"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Сохранить и войти" Width="170" Margin="0,0,10,0" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    <Button Content="Отмена" Width="120" Style="{StaticResource ButtonBase}" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
