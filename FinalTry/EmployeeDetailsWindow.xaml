<Window x:Class="HrDepartment.EmployeeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личная карточка сотрудника"
        Height="820"
        Width="1080"
        MinWidth="940"
        MinHeight="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Личная карточка сотрудника" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Подробная кадровая информация по выбранному сотруднику" Style="{StaticResource HintText}" Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Style="{StaticResource InfoBadge}">
                            <TextBlock Text="Актуальные данные" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource InfoBadge}">
                            <TextBlock Text="История карьеры" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                        </Border>
                        <Border Style="{StaticResource InfoBadge}">
                            <TextBlock Text="События сотрудника" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="17" TextAlignment="Right"/>
                        <TextBlock Text="{Binding CurrentPosition}" Style="{StaticResource HintText}" TextAlignment="Right" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding CurrentDepartment}" Style="{StaticResource HintText}" TextAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="Общие сведения" Style="{StaticResource SubtitleText}" Margin="0,0,0,14"/>

                            <TextBlock Text="ФИО" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding FullName}" Margin="0,0,0,12" IsReadOnly="True"/>

                            <TextBlock Text="Дата рождения" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding BirthDateDisplay}" Margin="0,0,0,12"/>

                            <TextBlock Text="Пол" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding Gender}" Margin="0,0,0,12"/>

                            <TextBlock Text="Место рождения" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding PlaceOfBirth}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Адрес проживания" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding Address}" TextWrapping="Wrap" Margin="0,0,0,0" IsReadOnly="True" AcceptsReturn="True" Height="72" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Документы и контакты" Style="{StaticResource SubtitleText}" Margin="0,0,0,14"/>

                            <TextBlock Text="Личный телефон" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding PersonalPhone}" Margin="0,0,0,12" IsReadOnly="True"/>

                            <TextBlock Text="Рабочий телефон" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding WorkPhone}" Margin="0,0,0,12" IsReadOnly="True"/>

                            <TextBlock Text="Корпоративный email" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding Email}" Margin="0,0,0,12" IsReadOnly="True"/>

                            <TextBlock Text="Паспортные данные" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding PassportData}" TextWrapping="Wrap" Margin="0,0,0,12" IsReadOnly="True" AcceptsReturn="True" Height="72" VerticalContentAlignment="Top"/>

                            <TextBlock Text="СНИЛС" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding SNILS}" Margin="0,0,0,12" IsReadOnly="True"/>

                            <TextBlock Text="ИНН" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding INN}" Margin="0,0,0,0" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="Кадровые сведения" Style="{StaticResource SubtitleText}" Margin="0,0,0,14"/>

                            <TextBlock Text="Подразделение" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding CurrentDepartment}" Margin="0,0,0,12"/>

                            <TextBlock Text="Должность" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding CurrentPosition}" Margin="0,0,0,12"/>

                            <TextBlock Text="Кабинет" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding Office}" Margin="0,0,0,12"/>

                            <TextBlock Text="Дата приема" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding EmploymentDateDisplay}" Margin="0,0,0,12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Дополнительно" Style="{StaticResource SubtitleText}" Margin="0,0,0,14"/>

                            <TextBlock Text="Гражданство" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding Citizenship}" Margin="0,0,0,12"/>

                            <TextBlock Text="Семейное положение" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding MaritalStatus}" Margin="0,0,0,12"/>

                            <TextBlock Text="Образование" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding Education}" TextWrapping="Wrap" Margin="0,0,0,12" IsReadOnly="True" AcceptsReturn="True" Height="72" VerticalContentAlignment="Top"/>

                            <TextBlock Text="Статус" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding VacationStatusDisplay}" Margin="0,0,0,12"/>

                            <TextBlock Text="Примечание" Style="{StaticResource SectionLabel}"/>
                            <TextBox Text="{Binding Note}" TextWrapping="Wrap" Margin="0,0,0,0" IsReadOnly="True" AcceptsReturn="True" Height="72" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <DataGrid x:Name="CareerHistoryGrid"
                                  ItemsSource="{Binding CareerHistory}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="*"/>
                                <DataGridTextColumn Header="Должность" Binding="{Binding PositionName}" Width="*"/>
                                <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="130"/>
                                <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy, TargetNullValue=Текущее место}" Width="150"/>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="CareerHistoryEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="История карьеры пока не заполнена" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="После кадровых перемещений записи появятся здесь автоматически." Style="{StaticResource HintText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <DataGrid x:Name="EventsGrid"
                                  ItemsSource="{Binding Events}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="190">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Тип события" Binding="{Binding EventTypeName}" Width="180"/>
                                <DataGridTextColumn Header="Дата начала" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="130"/>
                                <DataGridTextColumn Header="Дата окончания" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="140"/>
                                <DataGridTextColumn Header="Обоснование" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="EventsEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="События сотрудника отсутствуют" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="После отпусков, переводов и других кадровых действий список появится в этом блоке." Style="{StaticResource HintText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="EditButton" Content="Редактировать" Width="140" Margin="0,0,10,0" Click="Edit_Click" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="SaveButton" Content="Сохранить" Width="140" Margin="0,0,10,0" Visibility="Collapsed" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="CareerMoveButton" Content="Кадровое перемещение" Width="190" Margin="0,0,10,0" Click="CareerMove_Click" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="VacationButton" Content="Оформить отпуск" Width="160" Margin="0,0,10,0" Click="Vacation_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Закрыть" Width="120" Click="Close_Click" Style="{StaticResource ButtonBase}"/>
        </StackPanel>
    </Grid>
</Window>
